## Default SDK configuration for the StickS3 board-support project
##
## The StickS3 uses ESP32-S3-PICO-1-N8R8. ESP32-S3 supports Bluetooth LE
## and does not support Bluetooth Classic / BR/EDR. The default transport is
## a custom Bluetooth Low Energy GATT status and rule-event service.

CONFIG_APP_TRANSPORT_BLE_GATT_RULE_EVENTS=y
CONFIG_APP_BLE_GATT_DEVICE_NAME="M5StickS3-Control"
CONFIG_APP_WIFI_ENABLE=y
CONFIG_APP_WIFI_AP_SSID="M5StickS3-Setup"
CONFIG_APP_WIFI_AP_PASSWORD=""
CONFIG_APP_WIFI_AP_CHANNEL=6
CONFIG_APP_WIFI_CONNECT_TIMEOUT_MS=15000
CONFIG_APP_WIFI_NTP_SYNC_TIMEOUT_MS=15000
CONFIG_LWIP_SNTP_MAX_SERVERS=4
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_APP_WIFI_KEYBOARD_PROVISIONING=n

## Sound-level capture is enabled by default for StickS3. The feature remains
## Kconfig-controllable and uses the capture-only ES8311/I2S microphone path.
CONFIG_APP_SPEAKER_ACTION=y
CONFIG_APP_SOUND_LEVEL_TRIGGERS=y
CONFIG_APP_USB_UAC_DEVICE=n
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

## Hardware automation facts are compiled into the default firmware profile:
## power.battery_percent, power.usb_present, bmi270.motion, and safe ADC1
## adc.voltage_mv sources stay available unless explicitly disabled in menuconfig.
CONFIG_APP_BATTERY_FACTS=y
CONFIG_APP_USB_POWER_FACTS=y
CONFIG_APP_BMI270_FACTS=y
CONFIG_APP_ADC_FACTS=y

## Prefer a larger ATT MTU for structured status and rule-event notifications.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

## Avoid first-boot RF calibration load warnings on freshly erased NVS by using
## full RF calibration instead of trying to load missing partial-calibration data.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

CONFIG_APP_STATUS_UI_LCD_REFRESH_MS=100
## The rule automation config is intentionally kept off app_main()'s stack,
## but ESP-IDF startup plus board/BLE bring-up still benefits from explicit
## headroom over the default main task stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

## Use a custom 8 MB partition table so the BLE/Wi-Fi/LCD/rule-automation app
## fits. ESP-IDF's default single factory app slot is only 1 MiB, which is too
## small for this firmware and leaves the board in a bootloader reset loop.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
